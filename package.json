{
  "name": "meydan",
  "private": true,
  "version": "1.0.0",
  "description": "Meydan oyun platformu: oyun bazli lisanslar, yayinci odalari ve 3D arcade sahneleri",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "start:prod": "node dist-server/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/index.cjs --external:better-sqlite3 --external:deasync --external:pg --external:fsevents"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^12.11.1",
    "deasync": "^0.1.32",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "lucide-react": "^0.460.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.180.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
