# ---------------------------------------------------------------------------
# Sunucu
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Tarayıcıda açtığın adres. Üretimde alan adınla birebir aynı olmalı.
APP_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Üretimde (HTTPS) true olmalı.
COOKIE_SECURE=false
# En az 32 karakterlik rastgele bir değer. Üretimde zorunludur.
SESSION_SECRET=degistir-bu-degeri-uretimde-uzun-rastgele-bir-anahtarla

# ---------------------------------------------------------------------------
# Veritabanı (SQLite)
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/taraftar-savasi.db
UPLOADS_DIR=./data/uploads

# ---------------------------------------------------------------------------
# Ödeme sağlayıcısı
#   test   → geliştirme/test sağlayıcısı (üretimde otomatik kapalı)
#   stripe → gerçek kart ödemeleri
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=test
TEST_PAYMENT_WEBHOOK_SECRET=test-webhook-secret-degistir
# Yalnızca geliştirmede test ödemesini zorla kapatmak için false yap.
# TEST_PAYMENTS_ENABLED=true

# Stripe (PAYMENT_PROVIDER=stripe ise zorunlu)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opsiyonel: sabit fiyat kimliği yerine dinamik price_data kullanıyoruz.
STRIPE_PRICE_ID=

# Shopier (sonraki faz: webhook ile otomatik lisans)
# Mağaza açıldığında webhook belirtecini buraya koy.
SHOPIER_WEBHOOK_TOKEN=

# YouTube canlı sohbet okuma (YouTube Data API v3 anahtarı)
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Canlı yayın event webhook'u (hediye / beğeni / yorum)
# ---------------------------------------------------------------------------
LIVE_WEBHOOK_SECRET=live-webhook-secret-degistir
# Üretimde doğrudan OBS WebSocket sohbet komutları varsayılan olarak kapalıdır.
# Test etmek için true yap; gerçek komutlar imzalı sağlayıcı webhook'undan gelir.
LIVE_COMMANDS_ENABLED=true

# ---------------------------------------------------------------------------
# Oyun döngüsü / güvenlik / demo
# ---------------------------------------------------------------------------
# İlk izleyici katıldığında turun otomatik başlama gecikmesi (ms)
LOBBY_AUTO_START_MS=10000
# Tur bittikten sonra lobiye dönüş gecikmesi (ms)
FINISHED_TO_LOBBY_MS=12000
RATE_LIMIT_ENABLED=true
# İlk çalıştırmada örnek yayıncıyı oluştur (yayinci@demo.com / Demo1234)
SEED_DEMO=false

# Süper admin hesabı (ilk açılışta oluşturulur; üretimde güçlü şifre kullan)
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin1234

# Canlı destek (opsiyonel): ülke kodu + numara, sadece rakam
# VITE_SUPPORT_WHATSAPP=905xxxxxxxxx
