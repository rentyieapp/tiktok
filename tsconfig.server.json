{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-server",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["server/src/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "web", "tests", "dist-server"]
}
